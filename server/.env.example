PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/siteforge
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Initial platform administrator. Created as a bcrypt hash in MongoDB at first boot.
ADMIN_USERNAME=siteforge-admin
ADMIN_PASSWORD=siteforge12
ADMIN_NAME=SiteForge Administrator
ADMIN_EMAIL=admin@example.com

# Optional real Gemini website content generation. The key stays on the server.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set these in the server .env when using transactional store emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
EMAIL_FROM=SiteForge <your-email@example.com>
